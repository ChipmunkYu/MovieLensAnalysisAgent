# SQLite works without any external service.
DATABASE_URL=sqlite:///./movie_tasks.db
# MySQL mode: mysql+pymysql://movielens:movielens@127.0.0.1:3306/movielens
DATA_DIR=./data
DEFAULT_INPUT_PATH=sample/ratings.dat
ARTIFACT_DIR=./data/artifacts
RULES_FILE=./rules/default.json

# local runs the pipeline in-process; hadoop submits Streaming jobs to a cluster.
DEFAULT_EXECUTOR=local

# Hadoop client settings (hadoop executor only).
HADOOP_BIN=hadoop
HDFS_BIN=hdfs
HDFS_WORK_DIR=/movielens/work
# Optional. Defaults to $HADOOP_HOME/share/hadoop/tools/lib/hadoop-streaming-*.jar,
# then to the entry found in `hadoop classpath`.
# HADOOP_STREAMING_JAR=/opt/hadoop/share/hadoop/tools/lib/hadoop-streaming-3.3.6.jar
# HADOOP_STREAMING_SCRIPTS=./hadoop/streaming
# Python available on every worker node:
STREAMING_PYTHON=python3
HADOOP_JOB_TIMEOUT=1800
# Optional reducer count. Leave unset to use the cluster default.
# HADOOP_JOB_REDUCES=2

# Recorded with every result; set the boundaries once and keep them stable.
DATA_VERSION=ml1m-raw-v1
# T1=2000-01-01T00:00:00Z
# T2=2003-01-01T00:00:00Z

# Optional OpenAI-compatible structured tool calling.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
