# SQLite works without any external service.
DATABASE_URL=sqlite:///./movie_tasks.db
# MySQL mode: mysql+pymysql://movielens:movielens@127.0.0.1:3306/movielens
DATA_DIR=./data
DEFAULT_INPUT_PATH=sample/ratings.dat
ARTIFACT_DIR=./data/artifacts
RULES_FILE=./rules/default.json

# Local mode: HADOOP_COMMAND starts with HADOOP_BIN; the local binary is checked.
HADOOP_BIN=hadoop
# Placeholders: {input}, {output}, {result}, {rules}
# HADOOP_COMMAND=hadoop jar /opt/jobs/movielens-cleaner.jar {input} {output} {result} {rules}
# External mode: use an installed client (for example ssh); all paths must be on a
# shared directory visible with the same paths locally and remotely.
# HADOOP_COMMAND=ssh hadoop-host /opt/jobs/run-cleaner {input} {output} {result} {rules}
# HADOOP_PREFLIGHT_COMMAND=ssh hadoop-host hadoop version

# Optional OpenAI-compatible structured tool calling.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
